{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "magenta", "2": "green" },
    "padding": { "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "magenta", "title": "green" } },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "  os" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "wm", "key": "  wm" },
    { "type": "terminal", "key": "  term" },
    { "type": "shell", "key": "  shell" },
    { "type": "packages", "key": "󰏖  pkgs" },
    { "type": "cpu", "key": "  cpu" },
    { "type": "gpu", "key": "󰢮  gpu" },
    { "type": "memory", "key": "  mem" },
    { "type": "uptime", "key": "  up" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
