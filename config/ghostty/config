# deep-space — ghostty (purple galaxy re-rice 2026-10-19)
font-family = "NullType"
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt

window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
window-decoration = false
background-opacity = 0.88
background-blur = true
gtk-titlebar = false
confirm-close-surface = false

cursor-style = bar
cursor-style-blink = true
cursor-color = #b46bff
cursor-text = #07060d
mouse-hide-while-typing = true
copy-on-select = clipboard

background = #07060d
foreground = #e6e0ff
selection-background = #2a2147
selection-foreground = #f2f0ff

palette = 0=#0f0d1a
palette = 1=#ff5c8a
palette = 2=#7dffa8
palette = 3=#ffd479
palette = 4=#7c4dff
palette = 5=#b46bff
palette = 6=#6ee7f2
palette = 7=#9a96b3
palette = 8=#5d5878
palette = 9=#ff7aa2
palette = 10=#a6ffcf
palette = 11=#ffe3a3
palette = 12=#a99bff
palette = 13=#d4b8ff
palette = 14=#9ff3fa
palette = 15=#f2f0ff

# ghostfx: nebula, preset balanced, palette cyberpunk-purple, quality eco
custom-shader = shaders/nebula-purple.glsl
custom-shader-animation = true
