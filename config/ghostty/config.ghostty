# Green phosphor CRT theme for Ghostty.
# Source of truth: config/ghostty/config.ghostty
# (symlinked declaratively to ~/.config/ghostty/config.ghostty by
# modules/user-desktop.nix — edit this file and rebuild, not the symlink).

# --- Font -------------------------------------------------------------
# JetBrainsMono Nerd Font is already installed system-wide
# (fonts.packages in configuration.nix); no new font dependency added.
font-family = JetBrainsMono Nerd Font Mono
font-size = 10
font-feature = -calt
font-feature = -liga

# --- Window -------------------------------------------------------------
window-padding-x = 6
window-padding-y = 6
background-opacity = 1.0
window-decoration = false

# --- Colors: black + phosphor green ------------------------------------
background = #000000
foreground = #00ff66

cursor-style = block
cursor-color = #33ff88
cursor-text = #000000
cursor-style-blink = true

selection-background = #003318
selection-foreground = #baffda

# ANSI + bright ANSI palette (0-15): green-dominant, muted secondaries,
# kept distinguishable for git status, diffs, cargo/nix output and TUIs
# (rmpc, htop-likes, etc). 16-255 keep Ghostty's default 256-color cube.
palette = 0=#001a0d
palette = 1=#d94f4f
palette = 2=#00ff66
palette = 3=#d9c74f
palette = 4=#4fa8d9
palette = 5=#b06fd9
palette = 6=#4fd9b0
palette = 7=#baf2d0
palette = 8=#0d3320
palette = 9=#ff6b6b
palette = 10=#33ff88
palette = 11=#f0e070
palette = 12=#6fc2f0
palette = 13=#d090f0
palette = 14=#6ff0c2
palette = 15=#e0ffe8

# --- CRT shader ----------------------------------------------------------
# Comment out the next line to disable the shader and keep the plain
# black/green theme (tunable constants live at the top of the shader file).
custom-shader = shaders/green-crt.glsl
