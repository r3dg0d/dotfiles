# deep-space — ghostty (purple galaxy re-rice 2026-10-19)
font-family = "NullType"
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt

window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
window-decoration = false
background-opacity = 0.88
background-blur = true
gtk-titlebar = false
confirm-close-surface = false

cursor-style = bar
cursor-style-blink = true
cursor-color = {{violet}}
cursor-text = {{void}}
mouse-hide-while-typing = true
copy-on-select = clipboard

background = {{void}}
foreground = #e6e0ff
selection-background = #2a2147
selection-foreground = {{text}}

palette = 0={{surface}}
palette = 1={{red}}
palette = 2={{green}}
palette = 3={{yellow}}
palette = 4={{nebula}}
palette = 5={{violet}}
palette = 6={{cyan}}
palette = 7={{subtext}}
palette = 8={{muted}}
palette = 9=#ff7aa2
palette = 10=#a6ffcf
palette = 11=#ffe3a3
palette = 12=#a99bff
palette = 13={{lavender}}
palette = 14=#9ff3fa
palette = 15={{text}}

# ghostfx: nebula, preset balanced, palette cyberpunk-purple, quality eco
custom-shader = shaders/nebula-purple.glsl
custom-shader-animation = true
