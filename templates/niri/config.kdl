// deep-space rice for niri — github.com/r3dg0d/dotfiles
// Colors come from palette/palette.json via tools/render.py. Edit the template, not config/.

input {
    keyboard {
        xkb {
            // layout "us"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
}

output "DP-1" {
    mode "3440x1440@179.989"
    scale 1
}

prefer-no-csd

layout {
    gaps 14
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-gradient from="{{nebula}}" to="{{lavender}}" angle=45 relative-to="workspace-view"
        inactive-color "{{overlay}}"
    }
    border {
        off
    }
    shadow {
        on
        softness 40
        spread 6
        offset x=0 y=8
        color "{{nebula}}33"
        inactive-color "#00000066"
    }
    struts {
        top 2
    }
}

window-rule {
    match title="^Galaxy Deepfake$"
    open-floating true
}

window-rule {
    match title="^Galaxy Screenshot$"
    open-floating true
}

window-rule {
    match title="^Galaxy Lyrics$"
    open-floating true
}

// galaxy-vm Construct apps (quickshell FloatingWindows): float, rounded, no tiling
window-rule {
    match title="^Galaxy (Android|Windows|Linux|iOS|macOS|VM) Construct$"
    match title="^Galaxy Disk Map$"
    open-floating true
    geometry-corner-radius 22
    clip-to-geometry true
}
// sudo terminals launched by galaxy-hub
window-rule {
    match title="^Galaxy (Updater|Storage|Network|Constructs)$"
    open-floating true
    default-column-width { fixed 980; }
    default-window-height { fixed 560; }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}
window-rule {
    match is-active=false
    opacity 0.96
}
// Construct apps draw their own ~0.95 background; don't stack the inactive dim on top
window-rule {
    match title="^Galaxy (Android|Windows|Linux|iOS|macOS|VM) Construct$"
    match title="^Galaxy Disk Map$"
    opacity 1.0
}

layer-rule {
    match namespace="^(wallpaper|mpvpaper)$"
    place-within-backdrop true
}

// galaxy quickshell panels: rounded, violet-tinted shadow like windows
layer-rule {
    match namespace="^galaxy-(hub|system-osd)$"
    geometry-corner-radius 22
    shadow {
        on
        softness 40
        spread 4
        offset x=0 y=8
        color "{{nebula}}40"
    }
}

overview {
    backdrop-color "{{void}}"
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

spawn-at-startup "xwayland-satellite"
// live wallpaper (mpvpaper) with swaybg fallback; sh so that ~ expands
spawn-sh-at-startup "sh ~/.config/niri/wallpaper.sh"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-sh-at-startup "bash ~/.config/quickshell/galaxy/start.sh"
// galaxy hub (weather / storage / updater / network), hidden until opened
spawn-sh-at-startup "QT_QUICK_CONTROLS_STYLE=Basic quickshell -c galaxy-hub --no-duplicate --daemonize"
// galaxy power menu, hidden until opened (Mod+Alt+P / waybar ⏻)
spawn-sh-at-startup "QT_QUICK_CONTROLS_STYLE=Basic quickshell -c galaxy-power --no-duplicate --daemonize"

environment {
    DISPLAY ":0"
}

cursor {
    xcursor-theme "Cursor-Concept-3-HDPi-Dark"
    xcursor-size 32
}

hotkey-overlay {
    skip-at-startup
}

animations {
    slowdown 1.0
    workspace-switch {
        spring damping-ratio=0.85 stiffness=900 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }
    window-open {
        duration-ms 220
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 160
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }
}

binds {
    // F1-F12 are left as plain function keys (they used to be bound to OSD actions here).
    Mod+Shift+K repeat=false hotkey-overlay-title="Toggle typing sounds" { spawn "python3" "/home/r3dg0d/.config/quickshell/keystroke-noise/toggle.py"; }
    Mod+Shift+M hotkey-overlay-title="Galaxy media" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy/start.sh"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Alt+P repeat=false hotkey-overlay-title="Galaxy: power menu" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-power/start.sh"; }
    Mod+Alt+W repeat=false hotkey-overlay-title="Galaxy: weather" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-hub/start.sh weather"; }
    Mod+Alt+S repeat=false hotkey-overlay-title="Galaxy: storage optimizer" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-hub/start.sh storage"; }
    Mod+Alt+U repeat=false hotkey-overlay-title="Galaxy: NixOS updater" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-hub/start.sh updater"; }
    Mod+Alt+V repeat=false hotkey-overlay-title="Galaxy: VM constructs" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-hub/start.sh constructs"; }
    Mod+Alt+A repeat=false hotkey-overlay-title="Galaxy: audio" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-hub/start.sh audio"; }
    Mod+Alt+N repeat=false hotkey-overlay-title="Galaxy: network" { spawn "bash" "-c" "bash ~/.config/quickshell/galaxy-hub/start.sh network"; }

    Mod+T hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }
    Mod+Return { spawn "ghostty"; }
    Mod+D hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }
    Mod+Space hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }
    Super+Alt+L hotkey-overlay-title="Lock screen" { spawn "swaylock" "-f" "-c" "{{void_nohash}}"; }
    XF86AudioRaiseVolume { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py volume-up"; }
    XF86AudioLowerVolume { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py volume-down"; }
    XF86AudioMute repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py mute"; }
    XF86AudioMicMute repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py microphones"; }
    XF86AudioPlay repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py play-pause"; }
    XF86AudioNext { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py next"; }
    XF86AudioPrev { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py previous"; }
    XF86MonBrightnessUp { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py brightness-up"; }
    XF86MonBrightnessDown { spawn "bash" "-c" "python3 ~/.config/quickshell/system-osd/action.py brightness-down"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Galaxy screenshots: region, screen, focused window → preview and editor
    Print repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/screenshot/capture.py region"; }
    Mod+Shift+S repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/screenshot/capture.py region"; }
    Ctrl+Print repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/screenshot/capture.py screen"; }
    Alt+Print repeat=false { spawn "bash" "-c" "python3 ~/.config/quickshell/screenshot/capture.py window"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}

window-rule {
    match title="^Galaxy Disk Map$"
    open-floating true
}
