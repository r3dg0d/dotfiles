// deep-space — waybar (niri)
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 8,
  "modules-left": ["custom/logo", "niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "network", "battery"],

  "custom/logo": { "format": "", "tooltip": false, "on-click": "fuzzel" },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": { "active": "", "default": "", "urgent": "" }
  },
  "niri/window": { "format": "{title}", "max-length": 48, "separate-outputs": true },
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": { "format": { "today": "<span color='{{violet}}'><b>{}</b></span>" } }
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰖪  offline",
    "tooltip-format": "{ifname}  {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "tray": { "icon-size": 16, "spacing": 8 }
}
